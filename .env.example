# Discord bot token (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Port for the Prometheus /metrics endpoint (default: 8081)
METRICS_PORT=

# Postgres connection (jdbc:postgresql://host:port/database)
DB_URL=
DB_USER=
DB_PASSWORD=

# How often to poll the FPL API for the next deadline (default: 15)
REMINDER_POLL_INTERVAL_MINUTES=

# Discord channel to post deadline reminders to; reminders are disabled if unset
REMINDER_CHANNEL_ID=

# How long before the deadline to send the reminder (default: 60)
REMINDER_LEAD_MINUTES=

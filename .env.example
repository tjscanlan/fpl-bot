# Discord bot token (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Port for the Prometheus /metrics endpoint (default: 8081)
METRICS_PORT=

# Postgres connection (jdbc:postgresql://host:port/database)
DB_URL=
DB_USER=
DB_PASSWORD=

# How often to poll the FPL API for the next deadline (default: 15)
REMINDER_POLL_INTERVAL_MINUTES=

# Discord channel to post deadline reminders to; reminders are disabled if unset
REMINDER_CHANNEL_ID=

# How long before the deadline to send the reminder (default: 60)
REMINDER_LEAD_MINUTES=

# Local (Europe/London) time to run the nightly price-check job, HH:mm (default: 01:30)
PRICE_CHECK_TIME=

# Discord channel to post price-change alerts to; alerts are disabled if unset
PRICE_ALERT_CHANNEL_ID=

# How often to poll fixtures for live match updates (default: 30)
LIVE_MATCH_POLL_INTERVAL_SECONDS=

# Discord channel to post live score updates to; updates are disabled if unset
LIVE_MATCH_CHANNEL_ID=
